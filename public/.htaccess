# ══════════════════════════════════════════════════
#  MyFinances — .htaccess
# ══════════════════════════════════════════════════

Options -Indexes -MultiViews

# ──────────────────────────────────────────────────
# REWRITE ENGINE (URLs amigáveis)
# ──────────────────────────────────────────────────
RewriteEngine On

# Servir sitemap.xml via PHP
RewriteRule ^sitemap\.xml$ sitemap.xml.php [L,QSA]

# Não redirecionar arquivos/diretórios existentes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

# ──────────────────────────────────────────────────
# HEADERS DE SEGURANÇA (OWASP + SEO)
# ──────────────────────────────────────────────────
<IfModule mod_headers.c>
    # Impede que o browser "adivinhe" o MIME type
    Header set X-Content-Type-Options "nosniff"

    # Proteção contra Clickjacking
    Header set X-Frame-Options "SAMEORIGIN"

    # XSS Protection legado
    Header set X-XSS-Protection "1; mode=block"

    # HTTPS: HSTS (ativar só em produção com HTTPS real)
    # Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Referrer para SEO: envia origem em links externos
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # Remove X-Powered-By
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# ──────────────────────────────────────────────────
# COMPRESSÃO GZIP (melhora Core Web Vitals)
# ──────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml
    AddOutputFilterByType DEFLATE text/css text/javascript application/javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml font/woff2 font/woff
</IfModule>

# ──────────────────────────────────────────────────
# CACHE DE ASSETS ESTÁTICOS (performance)
# ──────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    # Fontes e imagens: 1 ano
    ExpiresByType image/png             "access plus 1 year"
    ExpiresByType image/jpeg            "access plus 1 year"
    ExpiresByType image/svg+xml         "access plus 1 year"
    ExpiresByType image/webp            "access plus 1 year"
    ExpiresByType image/x-icon          "access plus 1 year"
    ExpiresByType font/woff2            "access plus 1 year"
    ExpiresByType font/woff             "access plus 1 year"
    # CSS / JS: 1 semana
    ExpiresByType text/css              "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    # HTML: sem cache (conteúdo dinâmico)
    ExpiresByType text/html             "access plus 0 seconds"
</IfModule>

# ──────────────────────────────────────────────────
# PROTEÇÃO DE ARQUIVOS SENSÍVEIS
# ──────────────────────────────────────────────────
<FilesMatch "\.(env|json|lock|sql|log|sh|bak)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Exceção: manifest.json pode ser lido
<Files "manifest.json">
    Order allow,deny
    Allow from all
</Files>

# ──────────────────────────────────────────────────
# CHARSET padrão (evita problemas de encoding)
# ──────────────────────────────────────────────────
AddDefaultCharset UTF-8

