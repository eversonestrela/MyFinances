# Database Configuration
# Host do banco de dados
# - Docker: use 'db'
# - XAMPP/WAMP: use 'localhost'
# - Hostinger: use 'localhost' (ou o host fornecido no painel)
DB_HOST=localhost

# Nome do banco de dados
DB_NAME=myfinances

# Usuário do banco de dados
DB_USER=root

# Senha do banco de dados
DB_PASS=

# Application Configuration
# URL base da aplicação (ex: http://localhost:8000 ou https://seudominio.com)
APP_URL=http://localhost:8000

# Nome da aplicação
APP_NAME=MyFinances

# Ambiente da aplicação (development ou production)
# Use 'production' na Hostinger
APP_ENV=development

# ── SEO / Analytics ──────────────────────────────────
# ID do Google Analytics 4 (ex: G-XXXXXXXXXX)
# Obtenha em: https://analytics.google.com
# Deixe em branco para desativar
GA_MEASUREMENT_ID=

# Session Configuration
# Nome da sessão (identificador único para cookies de sessão)
SESSION_NAME=myfinances_session

# Tempo de expiração da sessão em segundos (7200 = 2 horas)
SESSION_LIFETIME=7200

